# Copy to .env and fill in. Never put these in the extension.
OPENAI_API_KEY=

# Paste the same value into the extension's Settings page for founder limits and the founder default model.
# Generate one with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
FOUNDER_TOKEN=

HOURLY_CAP=50
FOUNDER_HOURLY_CAP=200
GLOBAL_HOURLY_CAP=600
# Reports per install per hour (per IP: 3x). Separate from the hourly cap above.
REPORT_HOURLY_CAP=10
HOST=127.0.0.1
PORT=8787
# Set to 1 only behind a reverse proxy that sets X-Forwarded-For
TRUST_PROXY=0

# Production only (see README, "Deploy the server to Render")
# HOST=0.0.0.0
# TRUST_PROXY=1
# ALLOWED_EXTENSION_IDS=your_packed_extension_id
# REPORTS_FILE=/var/data/reports.jsonl
