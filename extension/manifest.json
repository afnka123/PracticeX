{
  "manifest_version": 3,
  "name": "StudyX",
  "version": "0.3.0",
  "description": "Reads the math problem on your screen and writes new practice problems of the same type.",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Open StudyX",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "sidePanel",
    "storage"
  ],
  "optional_host_permissions": [
    "<all_urls>"
  ]
}
