{
  "manifest_version": 3,
  "name": "PracticeX",
  "version": "0.6.2",
  "description": "Reads the question on your screen (math, science, writing or languages) and writes new practice problems of the same type.",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Open PracticeX",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "storage"
  ],
  "optional_host_permissions": [
    "<all_urls>"
  ]
}
